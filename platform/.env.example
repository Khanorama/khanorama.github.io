# Firebase web configuration for the LeapCode platform.
#
# Copy to .env.local for development, and set the same names as secrets in
# the deployment workflow. A static export inlines these at build time, so
# the build environment must have them; setting them only at runtime does
# nothing.
#
# These values are PUBLIC. They ship inside the client bundle by design and
# identify the Firebase project rather than authorise anything. Access is
# controlled by firestore.rules. Do not put anything genuinely secret here,
# such as a service account key or an admin credential.
#
# Find them in the Firebase console under:
#   Project settings  >  General  >  Your apps  >  SDK setup and configuration
#
# Leaving these unset is supported. The platform then runs without accounts:
# lessons work, code runs, and progress saves to the browser only.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
