// Cloud Firestore rules. These belong in Firestore Database > Rules.
// Realtime Database is a different product and its rules are JSON;
// pasting this there fails with "Line 1: Parse error".
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Organizers who may read every student's record.
     *
     * Membership is one document per uid in /admins, added by hand in the
     * Firebase console. There is deliberately no way to grant it from inside
     * the app: the collection is unwritable from any client, so becoming an
     * organizer always requires console access to the project. That keeps the
     * set of people who can read student work small, visible in one place,
     * and impossible to extend by finding a bug in the site.
     *
     * Note what this does NOT grant. An organizer can read; they can never
     * write to or delete another person's record. A student remains the only
     * account that can change their own work.
     */
    function isOrganizer() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // An organizer may check their own membership, which is how the app
      // decides whether to offer the roster at all. Reading somebody else's
      // row is not allowed, so this cannot be used to enumerate organizers.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      // Console only. See above.
      allow write: if false;
    }

    // One document per student, holding their course progress.
    // The API key is public, so these rules are the real security boundary.
    match /users/{uid} {

      allow read: if request.auth != null
                  && (request.auth.uid == uid || isOrganizer());

      // Writing stays the student's alone, organizer or not.
      //
      // hasOnly keeps a signed-in student from adding fields of their own,
      // such as anything a later feature might come to trust.
      //
      // `name` is a copy of the display name already held in Firebase
      // Authentication, kept here because the client SDK cannot read the
      // Authentication record of another account: without it the roster can
      // only show opaque uids. It is self-reported and self-writable, so it
      // identifies a row rather than proving who someone is. The size cap
      // stops the field being used as storage for something else.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['progress', 'updatedAt', 'name'])
                            && request.resource.data.progress is map
                            && (!('name' in request.resource.data)
                                || (request.resource.data.name is string
                                    && request.resource.data.name.size() <= 80));

      // A student can delete their own record, which is what makes the
      // "delete my account" button on the account page work. It stays
      // scoped to their own uid like every other rule here, so this grants
      // nobody access to anybody else's row.
      //
      // The app deletes this document BEFORE deleting the auth account,
      // and that order is required rather than tidy: the rule above keys
      // on request.auth.uid, so once the account is gone the document can
      // never be reached again by anyone.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
