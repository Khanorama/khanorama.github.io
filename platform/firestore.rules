// Cloud Firestore rules. These belong in Firestore Database > Rules.
// Realtime Database is a different product and its rules are JSON;
// pasting this there fails with "Line 1: Parse error".
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per student, holding their course progress.
    // The API key is public, so these rules are the real security boundary.
    match /users/{uid} {

      allow read: if request.auth != null && request.auth.uid == uid;

      // hasOnly keeps a signed-in student from adding fields of their own,
      // such as anything a later feature might come to trust.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
                            && request.resource.data.progress is map;

      // A student can delete their own record, which is what makes the
      // "delete my account" button on the account page work. It stays
      // scoped to their own uid like every other rule here, so this grants
      // nobody access to anybody else's row.
      //
      // The app deletes this document BEFORE deleting the auth account,
      // and that order is required rather than tidy: the rule above keys
      // on request.auth.uid, so once the account is gone the document can
      // never be reached again by anyone.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
