rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per student, holding their course progress.
    // The API key is public, so these rules are the real security boundary.
    match /users/{uid} {

      allow read: if request.auth != null && request.auth.uid == uid;

      // hasOnly keeps a signed-in student from adding fields of their own,
      // such as anything a later feature might come to trust.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
                            && request.resource.data.progress is map;

      allow delete: if false;
    }
  }
}
